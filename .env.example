# Copy to .env (never commit .env). All values are read at build time by Vite.

# --- Firebase web app config (Firebase console > Project settings > Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase App Check ---
# reCAPTCHA Enterprise site key (production attestation provider).
VITE_APPCHECK_SITE_KEY=
# Debug token for local dev / judging. Leave empty on `npm run dev` to let the SDK
# print a fresh token in the browser console (register it in console > App Check > Apps > Manage debug tokens).
# If you paste a token here, it is embedded in the bundle: only do that for a judging build and revoke it afterwards.
VITE_APPCHECK_DEBUG_TOKEN=

# --- Cloud fallback model used by Firebase AI Logic (optional override) ---
VITE_CLOUD_MODEL=gemini-2.5-flash
